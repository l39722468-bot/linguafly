    "eas:build:all": "eas build --platform all --profile production"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.1.2",
    "@supabase/supabase-js": "^2.49.1",
    "expo": "~52.0.0",
    "expo-apple-authentication": "~7.2.4",
    "expo-auth-session": "~6.0.3",
    "expo-av": "~15.0.2",
    "expo-crypto": "~14.0.2",
    "expo-file-system": "~18.0.12",
    "expo-linking": "~7.0.5",
    "expo-status-bar": "~2.0.0",
    "expo-web-browser": "~14.0.2",
    "react": "18.3.1",
    "react-native": "0.76.5"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "eas-cli": "^14.0.0",
    "typescript": "^5.7.2"
  }
