{
  "name": "focus-english-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "eas:init": "eas init",
    "eas:build:android": "eas build --platform android --profile preview",
