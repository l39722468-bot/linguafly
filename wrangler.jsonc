{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Nombre del Worker en el dashboard de Cloudflare (sin guion).
  "name": "linguaflyapp",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "minify": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "linguaflyapp"
    }
  ],
  "images": {
    "binding": "IMAGES"
  }
}
