# Supabase Configuration
# Get these from your Supabase project settings: https://app.supabase.com
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# HubSpot CRM Configuration
# Get your Access Token from: Settings → Integrations → Private Apps
# Create a Private App with required scopes (see CRM_PYTHON_DOCS.md)
HUBSPOT_ACCESS_TOKEN=pat-xxx-your-private-app-token-here
HUBSPOT_API_KEY=pat-xxx-your-private-app-token-here
HUBSPOT_PORTAL_ID=your_hubspot_portal_id_here
HUBSPOT_API_URL=https://api.hubapi.com

# Stripe Configuration (TEST MODE)
# Get these from: https://dashboard.stripe.com/test/apikeys
# Make sure "View test data" toggle is ON
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Stripe Webhook Secret (TEST MODE)
# Get this after creating webhook at: https://dashboard.stripe.com/test/webhooks
# Endpoint URL: https://your-domain.com/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Price ID — suscripción mensual única (0,99 €/mes en el producto de Stripe)
STRIPE_PRICE_BASIC_MONTHLY=price_xxx_basic_monthly

# Application Configuration
NEXT_PUBLIC_SITE_URL=https://www.focus-on-english.com

# For local development, use:
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================================================
# IndexNow (Bing / Indexación rápida)
# ============================================================================
# Clave IndexNow (puedes generarla con: openssl rand -hex 16)
INDEXNOW_KEY=your_indexnow_key_here
# Token para proteger el endpoint interno /api/indexnow/submit
INDEXNOW_SUBMIT_TOKEN=your_internal_submit_token_here
# Opcional: URL pública donde Bing valida tu clave (si no se define, usa
# https://www.focus-on-english.com/indexnow-key.txt automáticamente)
# INDEXNOW_KEY_LOCATION=https://www.focus-on-english.com/indexnow-key.txt

# ElevenLabs Text-to-Speech Configuration
# Get your API key from: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# NextAuth Configuration
# Generate secret with: openssl rand -base64 32
NEXTAUTH_URL=https://www.focus-on-english.com
NEXTAUTH_SECRET=your_nextauth_secret_here_generate_with_openssl

# OAuth Providers (opcional)
# Google OAuth: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# GitHub OAuth: https://github.com/settings/developers
GITHUB_ID=your_github_oauth_app_id_here
GITHUB_SECRET=your_github_oauth_app_secret_here

# Resend (Email Service)
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# Google Analytics 4 Configuration
# Get your Measurement ID from: https://analytics.google.com/
# Current Measurement ID: G-34F4YG3ZHF (Focus English production)
# ID de Propiedad: 380786116
# Esta cuenta está activa y recibiendo datos desde enero 2026
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-34F4YG3ZHF

# Cookiebot Consent Management Platform (CMP)
# Get your Cookiebot ID from: https://www.cookiebot.com/
# This is used for GDPR compliance and cookie consent management
NEXT_PUBLIC_COOKIEBOT_ID=474b1dce-7229-40d3-88c2-a2323b9a57f9

# ============================================================================
# OpenAI API Configuration (RECOMENDADO para Focus English)
# ============================================================================
# Get your API key from: https://platform.openai.com/api-keys
# 
# Modelos usados en el proyecto:
#   - gpt-4o: Evaluaciones complejas (Speaking FCE Parts 1-4, Writing)
#   - gpt-4o-mini: Evaluaciones simples (Multiple Choice, Grammar)
#   - whisper-1: Transcripción de audio (speech-to-text)
#
# Costo estimado: ~$52.50/mes para 100 estudiantes activos
# Ver OPENAI_API_CONFIGURATION_GUIDE.md para más detalles
#
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# Opcional: Organization ID (solo si tienes múltiples organizaciones)
OPENAI_ORG_ID=org-xxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# Gemini API (ALTERNATIVA - usa OpenAI si está disponible)
# ============================================================================
# Get your API key from: https://makersuite.google.com/app/apikey
# Nota: OpenAI es mejor para evaluaciones educativas y transcripción de audio
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================================
# Juego de inglés: assets (Leonardo + Runway)
# ============================================================================
# Leonardo: https://app.leonardo.ai/settings/api
LEONARDO_API_KEY=your_leonardo_api_key_here
# Runway: https://docs.dev.runwayml.com/
RUNWAY_API_KEY=your_runway_api_key_here

# ============================================================================
# Cloudflare Workers AI (TTS Aura, LLM, Whisper en rutas /api)
# ============================================================================
# Dashboard → Workers AI → Use REST API → Account ID + Workers AI API token
# (Tutor avatar, y GET /api/vocabulario/tts — audio del megaglosario con @cf/deepgram/aura-2-en)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_workers_ai_api_token
# Opcional: si es 1, la puerta pedagógica previa a mostrar ejercicios también excluye ítems con solo PQ_* warn (además de error).
# PEDAGOGY_DISPLAY_GATE_BLOCK_WARNINGS=1
# Opcional: URL de /api/tts del despliegue (scripts/generate-podcast-audio.mjs) — POST { text, speaker }
# TTS_HTTP_URL=https://www.tu-dominio.com/api/tts
# Opcional: URL de un Worker que haga TTS (POST JSON { text, speaker }) y devuelva MP3 o el mismo JSON que la API REST
# CLOUDFLARE_TTS_WORKER_URL=https://tts-tu-worker.tu-subdominio.workers.dev
# CLOUDFLARE_TTS_WORKER_SECRET=opcional_bearer_para_el_worker
