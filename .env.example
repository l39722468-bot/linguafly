# Cloudflare D1 Database
D1_DATABASE_ID=476f34d4-5622-4a56-923e-c4fb571578c2

# API Keys
ARTICLES_API_KEY=your-secure-api-key-here

# Environment
ENVIRONMENT=production
NODE_ENV=production

# Database
DB_NAME=linguafly_db

# Cache
CACHE_TTL=86400
SEARCH_CACHE_TTL=3600

# Rate Limiting
RATE_LIMIT_REQUESTS=10000
RATE_LIMIT_WINDOW_MS=60000

# Analytics
ANALYTICS_ENABLED=true

# AdSense display units (optional; Auto Ads still load from the publisher id)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-1198438843650445
NEXT_PUBLIC_ADSENSE_SLOT_LEADERBOARD=
NEXT_PUBLIC_ADSENSE_SLOT_IN_ARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_FEED=
# 1 = fill live ads in non-production; 0 = keep labeled placeholders
NEXT_PUBLIC_ADSENSE_FILL=

# Max articles for bulk import
MAX_ARTICLES=1000000
BATCH_SIZE=1000