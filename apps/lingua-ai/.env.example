# LinguaFly AI usa bindings de Cloudflare Workers y D1, no estas variables
# para acceder a la base de datos. Para desarrollo local, copia .dev.vars.example
# como .dev.vars y completa BETTER_AUTH_SECRET con un secreto aleatorio.
# En producción, BETTER_AUTH_SECRET se configura como secreto de Worker.
BETTER_AUTH_URL=http://localhost:5440
