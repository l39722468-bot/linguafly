# Valores ficticios de ejemplo. No son credenciales reales.
# Crea un proyecto NUEVO de Supabase y copia la URL y la clave anon/public.
# No uses la clave service_role en esta aplicación.
# No reutilices las variables de mobile/.

NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=example-anon-key-not-a-real-secret

# Origen permitido para los enlaces de confirmación y de recuperación.
# Solo se usa este valor. El host de la petición no se tiene en cuenta.
# Tiene que ser una URL http(s) sin usuario, ruta, consulta ni fragmento.
# http solo se acepta para localhost, 127.0.0.1 y ::1.
#
# Local:
#   APP_ORIGIN=http://localhost:5440
#
# En Vercel, más adelante, define APP_ORIGIN con el origen HTTPS del
# proyecto en Settings → Environment Variables. El mismo origen, con la
# ruta /auth/callback, tiene que estar en las Redirect URLs de Supabase
# Auth. No configures todavía el dominio de producción.
APP_ORIGIN=http://localhost:5440
