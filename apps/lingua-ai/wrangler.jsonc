{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lingua-ai-app",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "minify": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "lingua-ai-app"
    }
  ],
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "lingua-ai-auth-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["noreply@linguafly.app"]
    }
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://app.linguafly.app",
    "AUTH_EMAIL_ENABLED": "true",
    "AUTH_EMAIL_FROM": "noreply@linguafly.app"
  },
  "observability": {
    "enabled": true
  }
}
