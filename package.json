{
  "name": "focus-english",
  "version": "1.0.0",
  "description": "Focus English - Cursos de Inglés Especializados para Trabajo, Viajes y Exámenes",
  "private": true,
  "scripts": {
    "dev": "next dev -p 5436",
    "build": "NODE_OPTIONS=--max-old-space-size=6144 next build",
    "build:analyze": "ANALYZE=true next build",
    "build:turbo": "next build --turbopack",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start -p ${PORT:-3000}",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest __tests__/unit",
    "test:integration": "jest __tests__/integration",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:mobile": "playwright test --project='Mobile Chrome' --project='Mobile Safari'",
    "test:e2e:report": "playwright show-report",
    "mobile:start": "cd mobile && npm start",
    "verify-openai": "ts-node scripts/verify-openai-setup.ts",
    "generate-audio": "ts-node --esm scripts/generate-course-audio.ts",
    "generate-audio:test": "ts-node --esm scripts/generate-course-audio.ts test",
    "generate-audio:all": "ts-node --esm scripts/generate-course-audio.ts all",
    "generate-audio:a1": "ts-node scripts/generate-course-audio-a1.ts",
    "generate-audio:a1:test": "ts-node scripts/generate-course-audio-a1.ts test",
    "generate-audio:a1:list": "ts-node scripts/generate-course-audio-a1.ts list",
    "generate-audio:a1:units": "ts-node scripts/generate-course-audio-a1.ts units",
    "demo-cat-assets": "ts-node --esm scripts/demo-cat-assets.ts",
    "generate-game-choices": "ts-node --esm scripts/generate-game-choice-assets.ts",
    "validate-exercises": "node scripts/validate-exercises.mjs",
    "validate:c1-units": "node scripts/validate-c1-units.mjs",
    "validate-exercise-types": "node scripts/validate-exercise-types.mjs",
    "validate-course-exercises-zod": "ts-node scripts/validate-course-exercises-zod.ts",
    "validate-c2-structure": "node scripts/validate-c2-structure.mjs",
    "validate-weeks": "node scripts/validate-week.mjs src/content/weeks/*.json",
    "audit-seo": "node scripts/audit-blog-seo.mjs",
    "audit-seo:full": "node scripts/audit-blog-seo-full.mjs",
    "indexnow": "node scripts/indexnow-submit.mjs",
    "indexnow:all": "node scripts/indexnow-submit.mjs --all",
    "indexnow:dry": "node scripts/indexnow-submit.mjs --dry-run",
    "audit:ui-es-cloudflare": "node scripts/audit-spanish-ui-cloudflare.mjs",
    "generate:vocabulario": "python3 scripts/generate-public-vocabulario.py",
    "podcasts:sync-audio-manifest": "node scripts/sync-podcast-audio-manifest.mjs",
    "podcasts:check-audio-manifest": "node scripts/sync-podcast-audio-manifest.mjs --check",
    "cf:build": "node scripts/cf-slim-routes.cjs hide && (npx --no-install tsx scripts/export-course-data.ts && npx --no-install tsx scripts/export-blog-data.ts && NODE_OPTIONS=--max-old-space-size=6144 npx --no-install @opennextjs/cloudflare build; status=$?; node scripts/cf-slim-routes.cjs restore; exit $status)",
    "cf:deploy": "npx --no-install @opennextjs/cloudflare deploy",
    "cf:upload": "npx --no-install @opennextjs/cloudflare upload",
    "export:course-data": "npx --no-install tsx scripts/export-course-data.ts",
    "export:blog-data": "npx --no-install tsx scripts/export-blog-data.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tailwindcss/typography": "^0.5.19",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "framer-motion": "^12.29.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.562.0",
    "next": "^15.5.23",
    "next-themes": "^0.4.6",
    "openai": "^6.16.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.4.0",
    "wrangler": "^4.121.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.1.6",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.2.3",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.12",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "playwright": "^1.57.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "keywords": [
    "english",
    "courses",
    "learning",
    "education",
    "language",
    "professional-english",
    "travel-english",
    "exam-preparation"
  ],
  "author": "Focus English",
  "license": "UNLICENSED"
}
